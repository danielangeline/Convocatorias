{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100,
      "autoPort": false
    },
    {
      "name": "dev-ia-prueba",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": false,
      "env": {
        "IA_PROVEEDOR": "prueba"
      }
    },
    {
      "name": "prod-ia-prueba",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100,
      "autoPort": false,
      "env": {
        "IA_PROVEEDOR": "prueba"
      }
    },
    {
      "name": "prod-upstash-caido",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3101"
      ],
      "port": 3101,
      "autoPort": false,
      "env": {
        "IA_PROVEEDOR": "prueba",
        "UPSTASH_REDIS_REST_URL": "https://127.0.0.1:9"
      }
    },
    {
      "name": "prod-ia-real",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3102"
      ],
      "port": 3102,
      "autoPort": false
    }
  ]
}